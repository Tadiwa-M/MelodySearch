# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# Flask Configuration
# Generate a strong secret key with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Image API Credentials (for Mood Board feature)
# Unsplash: Get free key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Pexels: Get free key from https://www.pexels.com/api/ (optional)
PEXELS_API_KEY=your-pexels-api-key-here

# Pixabay: Get free key from https://pixabay.com/api/docs/ (optional)
PIXABAY_API_KEY=your-pixabay-api-key-here

# Flask Environment
# Options: development, production
FLASK_ENV=production

# Server Port (optional)
PORT=5000
